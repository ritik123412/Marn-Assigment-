
/* =================================
   1. UNIVERSAL SELECTOR
================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}



/* =================================
   2. ELEMENT SELECTORS
================================= */

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #edf3f7;
    color: #1c394d;
    line-height: 1.6;
}

h1, h2, h3 {
    color: #1c394d;
}

h2 {
    font-size: 30px;
    margin-bottom: 12px;
}

p {
    font-size: 18px;
}

a {
    text-decoration: none;
    color: inherit;
}

ul, ol {
    padding-left: 25px;
    font-size: 18px;
}


#navbar {
    background-color: #153f42;
    color: white;
    padding: 15px 25px;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

#navbar .logo {
    font-size: 22px;
    font-weight: bold;
}

.nav-links {
    display: flex;
    gap: 20px;
}

.nav-links a {
    color: white;
    font-size: 16px;
}

.nav-links a:hover {
    color: #a9d6c4;
}



/* =================================
   4. CLASS SELECTORS - HERO
================================= */

.hero {
    background-color: #dfede6;
    border: 2px solid #d1e0df;
    padding: 45px 35px;

    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
}

.hero-content h3 {
    color: #187477;
    font-size: 20px;
    margin-bottom: 15px;
}

.hero-content h1 {
    font-size: 44px;
    line-height: 1.4;
    margin-bottom: 20px;
}

.hero-content p {
    font-size: 20px;
    margin-bottom: 20px;
}

.btn {
    display: inline-block;
    background-color: #187477;
    color: white;
    padding: 10px 20px;
    border-radius: 5px;
    font-size: 18px;
}

.btn:hover {
    background-color: #115658;
}


/* =================================
   5. PROFILE IMAGE
================================= */

.profile img {
    width: 180px;
    height: 210px;
    object-fit: cover;
    border-radius: 10px;
    border: 2px solid #cbdcdb;
}


/* =================================
   6. MAIN CONTAINER
================================= */

.container {
    padding: 35px;
    max-width: 1400px;
    margin: auto;
}

.container section {
    margin-bottom: 35px;
}


/* =================================
   7. SKILLS SECTION
================================= */

.skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    list-style: none;
    padding: 0;
}

.skills-list li {
    font-size: 19px;
}


/* =================================
   8. PROJECT SECTION
================================= */

.project-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 20px;
}

.project-card {
    background-color: white;
    border: 2px solid #d1dfe8;
    border-radius: 12px;
    padding: 16px;
    overflow: hidden;
}

.project-card img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 7px;
}

.project-content {
    padding: 10px 5px;
}

.project-content h3 {
    font-size: 25px;
    margin-bottom: 10px;
}

.project-content p {
    font-size: 18px;
}


/* =================================
   9. CONTACT SECTION
================================= */

#Contact {
    padding: 15px 0;
}

#Contact a {
    color: #187477;
    font-weight: bold;
}

#Contact a:hover {
    text-decoration: underline;
}


/* =================================
   10. FOOTER
================================= */

#footer {
    background-color: #153f42;
    color: white;
    padding: 18px 25px;
    margin: 15px;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

#footer p {
    font-size: 20px;
    font-weight: bold;
}

.footer-links {
    display: flex;
    gap: 20px;
}

.footer-links a {
    color: white;
}


/* =================================
   11. RESPONSIVE DESIGN
================================= */

@media (max-width: 768px) {

    #navbar {
        flex-direction: column;
        gap: 15px;
    }

    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero {
        flex-direction: column-reverse;
        text-align: center;
    }

    .hero-content h1 {
        font-size: 32px;
    }

    .project-container {
        grid-template-columns: 1fr;
    }

    .skills-list {
        gap: 15px;
    }

    #footer {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }

    .footer-links {
        flex-wrap: wrap;
        justify-content: center;
    }

}
